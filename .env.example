# PostgreSQL connection string. Create your own local .env.local from this file.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/routewise

# Neo4j connection details
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j

# Use a long random value; keep it secret.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
